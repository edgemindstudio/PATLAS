{
  "name": "patlas",
  "version": "0.1.0",
  "private": true,
  "description": "PATLAS \u2014 Probabilistic Atlas. A visual-first atlas of probabilistic models.",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:python": ".venv/bin/python -m pytest python/tests -q",
    "test:e2e": "playwright test",
    "setup:python": "python3 -m venv .venv && .venv/bin/python -m pip install --upgrade pip && .venv/bin/python -m pip install -r python/requirements.txt",
    "test:unit:node": "vitest run tests/unit/registry tests/unit/search tests/unit/content tests/unit/architecture tests/unit/accessibility",
    "test:unit:science": "vitest run tests/unit/science"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "katex": "0.19.1",
    "marked": "18.3.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sanitize-html": "2.18.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@playwright/test": "1.65.1",
    "@types/katex": "0.16.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://patlas.local/schema/scope-baseline.schema.json",
  "title": "PATLAS frozen model scope baseline",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "root", "categories", "modules", "counts"],
  "properties": {
    "schema_version": { "type": "string" },
    "status": { "type": "string" },
    "source": { "type": "string" },
    "root": { "type": "string", "minLength": 1 },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/categoryNode" }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/module" }
    },
    "counts": {
      "type": "object",
      "required": [
        "major_categories",
        "category_nodes",
        "leaf_occurrences",
        "canonical_leaf_modules"
      ],
      "properties": {
        "major_categories": { "type": "integer", "minimum": 1 },
        "category_nodes": { "type": "integer", "minimum": 1 },
        "leaf_occurrences": { "type": "integer", "minimum": 1 },
        "canonical_leaf_modules": { "type": "integer", "minimum": 1 }
      }
    },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "definitions": {
    "categoryNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "id", "children"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              { "$ref": "#/definitions/categoryNode" },
              { "$ref": "#/definitions/leafPlacement" }
            ]
          }
        }
      }
    },
    "leafPlacement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "module_id"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "module_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "aliases", "status"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": { "type": "string", "minLength": 1 },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "status": { "type": "string", "enum": ["planned"] }
      }
    }
  }
}
